<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- No INTERNET or screenshot/media permissions. Instagram content never leaves the device. -->
    <queries><package android:name="com.instagram.android"/></queries>
    <application android:label="Animal Voices – Instagram"
      android:theme="@android:style/Theme.Material.Light.NoActionBar"
      android:usesCleartextTraffic="false" android:allowBackup="false">
      <activity android:name=".MainActivity" android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN"/>
          <category android:name="android.intent.category.LAUNCHER"/>
        </intent-filter>
      </activity>
      <service android:name=".VoicesService"
          android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
          android:exported="true">
        <intent-filter>
          <action android:name="android.accessibilityservice.AccessibilityService"/>
        </intent-filter>
        <meta-data android:name="android.accessibilityservice"
          android:resource="@xml/voices_accessibility"/>
      </service>
    </application>
</manifest>
